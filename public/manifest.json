{
  "manifest_version": 3,
  "name": "TermVault 术语库",
  "short_name": "TermVault",
  "version": "1.0.0",
  "description": "中英文术语库：AI / 编程单词一键自动翻译、同义词反义词、快速查询",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["sidePanel", "contextMenus", "storage"],
  "host_permissions": ["https://translate-word-vault.vercel.app/*"],
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "TermVault — 打开术语库"
  },
  "minimum_chrome_version": "116"
}
